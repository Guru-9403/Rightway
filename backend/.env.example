# Supabase PostgreSQL (Prisma ORM)
# Transaction pooler connection string (Port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# Direct connection string (Port 5432) for running migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# MongoDB Connection URI (Source DB for data migration)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dbname

# JWT Secrets & Expiry
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server & Origins
PORT=5000
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173,http://localhost:5000

# Firebase Auth Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Admin Configuration
ADMIN_EMAILS=admin@rightwayskillbuilder.com

# Resend API Configuration (Primary Email Service)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Rightway Skill Builder <no-reply@rightwayinstitute.com>

# Gmail SMTP Configuration via Nodemailer (Google App Password) - Fallback
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
EMAIL_FROM=Rightway Skill Builder <your_email@gmail.com>

# Environment
NODE_ENV=development
